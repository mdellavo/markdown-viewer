[Desktop Entry]
Type=Application
Name=Markdown Viewer
GenericName=Markdown Viewer
Comment=Render Markdown with GitHub styling and live-reload it in your browser
Exec=markdown-viewer --watch --exit-when-closed %f
Icon=markdown-viewer
Terminal=false
NoDisplay=false
StartupNotify=false
Categories=Utility;TextTools;
Keywords=markdown;md;readme;preview;csv;
MimeType=text/markdown;text/x-markdown;text/csv;text/tab-separated-values;
