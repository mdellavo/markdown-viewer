#compdef markdown-viewer

autoload -U is-at-least

_markdown-viewer() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'(-w --watch --pdf)-o+[Write the rendered HTML to this file ("-" for stdout) instead of opening it]:PATH:_files' \
'(-w --watch --pdf)--output=[Write the rendered HTML to this file ("-" for stdout) instead of opening it]:PATH:_files' \
'(-w --watch)--pdf=[Write a PDF to this file instead of opening it (needs Chrome, Chromium, Edge, Brave or Vivaldi)]:PATH:_files' \
'-p+[Port for --watch (default\: any free port)]:PORT:_default' \
'--port=[Port for --watch (default\: any free port)]:PORT:_default' \
'--browser=[Browser to open instead of the default (e.g. "Google Chrome", "firefox")]:NAME:_default' \
'--theme=[Colour theme (default\: the one you last chose in the viewer, else auto). Press t in the viewer to switch]:THEME:((auto\:"Follow the operating system'\''s light/dark setting"
light\:""
dark\:""))' \
'--style=[Page style]:STYLE:((github\:"GitHub'\''s README look"
wide\:"GitHub'\''s look, using the full window width"
book\:"Serif type and a narrower column, for long-form reading"
compact\:"Smaller type and tighter spacing, for dense documents"))' \
'--css=[Extra CSS file, applied after the built-in styles]:PATH:_files' \
'--front-matter=[YAML front matter\: shown as a table, like GitHub (default), or hidden]:HOW:((table\:"Show it as a table, like GitHub"
hide\:"Leave it out"))' \
'--editor=[Editor for double-click-to-source, e.g. "zed" or "code -g {file}\:{line}" (default\: \$VISUAL/\$EDITOR if it'\''s a GUI editor, else the first one found)]:COMMAND:_default' \
'--generate-completions=[Print a shell completion script (bash, zsh, fish, elvish, powershell)]:SHELL:(bash elvish fish powershell zsh)' \
'-w[Serve the page and live-reload it whenever the file changes]' \
'--watch[Serve the page and live-reload it whenever the file changes]' \
'()--clipboard[Preview the clipboard instead of a file. With --watch, the page follows the clipboard as it changes]' \
'--no-open[Don'\''t open a browser]' \
'--app[Open as a minimal app window with no tabs or address bar (default). Chrome, Edge, Brave, Chromium and Vivaldi only; other browsers get a new window]' \
'--window[Open in a normal new browser window]' \
'--tab[Open in a tab of an existing browser window]' \
'--exit-when-closed[With --watch\: exit once the page has been closed (used by the Finder integration, where there'\''s no terminal to press Ctrl-C in)]' \
'--number-headings[Number headings (1, 1.1, 1.2, …)]' \
'--obsidian[Obsidian notes\: \[\[wiki links\]\], !\[\[embeds\]\], callouts, ==highlights== and %%comments%%. On by default inside a vault (a .obsidian folder)]' \
'--no-obsidian[Turn off Obsidian notes, even inside a vault]' \
'--generate-man[Print the man page]' \
'--install-finder[macOS\: add "Markdown Viewer" to Finder (Open With, double-click and a right-click Quick Action) for the current user]' \
'--uninstall-finder[macOS\: remove the Finder integration]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
'::file -- Markdown file to render, a folder to browse (default\: the current folder), or "-" to read standard input. Folders are always served with live reload:_files' \
&& ret=0
}

(( $+functions[_markdown-viewer_commands] )) ||
_markdown-viewer_commands() {
    local commands; commands=()
    _describe -t commands 'markdown-viewer commands' commands "$@"
}

if [ "$funcstack[1]" = "_markdown-viewer" ]; then
    _markdown-viewer "$@"
else
    compdef _markdown-viewer markdown-viewer
fi
